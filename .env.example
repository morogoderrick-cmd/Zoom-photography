# Copy this file to .env for local use. On Render, add these in Environment > Environment Variables.

# --- Required ---
# MongoDB Atlas connection string (see README step 1)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/zoom?retryWrites=true&w=majority
# Long random string, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Your admin login. Created automatically the first time the server starts.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password-here
# Websites allowed to call this API, comma separated, no trailing slash
ALLOWED_ORIGINS=https://yourdomain.co.ke,https://www.yourdomain.co.ke

# --- Email (optional, recommended) ---
# Render's free plan blocks SMTP ports, so use Brevo's web API (see README step 2).
BREVO_API_KEY=
# The sender address you verified in Brevo, for example: ZOOM Photography <you@gmail.com>
MAIL_FROM=
# Where new enquiries are sent
NOTIFY_EMAIL=
# Only for a paid Render plan or your own computer (Gmail: smtp.gmail.com, 465, app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Birthday emails (optional) ---
# Long random string (16+ chars). A free daily cron job sends it as the X-Cron-Key header to POST /api/cron/birthdays
CRON_SECRET=
